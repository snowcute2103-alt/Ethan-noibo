# Copy sang .env.local (KHÔNG commit .env.local lên git).
# SESSION_SECRET: chuỗi ngẫu nhiên bất kỳ, tối thiểu 32 ký tự — dùng để ký session token.
SESSION_SECRET=

# DATABASE_URL: connection string Postgres, Vercel tự inject khi link project
# với 1 tích hợp Storage (Neon...) và chạy `vercel env pull .env.local --environment=production`.
# Biến này đánh dấu Sensitive nên không xem lại được qua dashboard/CLI sau khi tạo —
# cần giá trị mới thì lấy ở trang Neon (Storage → database → "Show secret").
DATABASE_URL=

# BLOB_READ_WRITE_TOKEN: token đọc/ghi Vercel Blob, dùng để upload ảnh đại diện.
# Vercel tự inject khi link project với 1 Blob store (`vercel blob create-store` hoặc qua dashboard)
# rồi chạy `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=

# RESEND_API_KEY: API key tài khoản Resend — dùng để tự động gửi mật khẩu mới cho
# BGĐ khi có yêu cầu "Quên mật khẩu" (xem app/api/forgot-password/route.ts).
# Lấy tại resend.com/api-keys sau khi đã tạo tài khoản + xác thực domain gửi.
RESEND_API_KEY=

# RESEND_FROM_EMAIL: địa chỉ gửi (vd "Cổng nội bộ <noreply@mail.ethanecom.com>") —
# domain phải đã verify DNS (SPF/DKIM) trong Resend, KHÔNG dùng domain chưa xác thực.
RESEND_FROM_EMAIL=
