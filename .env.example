# Copy sang .env.local (KHÔNG commit .env.local lên git).
# SESSION_SECRET: chuỗi ngẫu nhiên bất kỳ, tối thiểu 32 ký tự — dùng để ký session token.
SESSION_SECRET=

# DATABASE_URL: connection string Postgres, Vercel tự inject khi link project
# với 1 tích hợp Storage (Neon...) và chạy `vercel env pull .env.local --environment=production`.
# Biến này đánh dấu Sensitive nên không xem lại được qua dashboard/CLI sau khi tạo —
# cần giá trị mới thì lấy ở trang Neon (Storage → database → "Show secret").
DATABASE_URL=

# RESEND_API_KEY: dùng để gửi email mật khẩu ban đầu cho tài khoản cá nhân (Phase 2).
RESEND_API_KEY=
