# Copy sang .env.local (KHÔNG commit .env.local lên git).
# SESSION_SECRET: chuỗi ngẫu nhiên bất kỳ, tối thiểu 32 ký tự — dùng để ký session token.
SESSION_SECRET=

# Mật khẩu từng tài khoản (dùng chung theo khối/cấp — không phải tài khoản cá nhân).
AUTH_PASSWORD_BGD=

AUTH_PASSWORD_KD_STAFF=
AUTH_PASSWORD_KD_LEADER=

AUTH_PASSWORD_SXTHEU_STAFF=
AUTH_PASSWORD_SXTHEU_LEADER=

AUTH_PASSWORD_SXIN_STAFF=
AUTH_PASSWORD_SXIN_LEADER=

AUTH_PASSWORD_RND_STAFF=
AUTH_PASSWORD_RND_LEADER=

AUTH_PASSWORD_IT_STAFF=
AUTH_PASSWORD_IT_LEADER=

AUTH_PASSWORD_FULFILLMENT_STAFF=
AUTH_PASSWORD_FULFILLMENT_LEADER=
